# ═══════════════════════════════════════
# 个人 A 股研究与风险辅助看板 — 环境变量模板
# ═══════════════════════════════════════
# ⚠️ 本文件仅是模板，不可原样用于生产。复制为 .env 后必须替换所有 CHANGE_ME 值。

# ── Python 后端 ──
APP_HOST=0.0.0.0
APP_PORT=5000
APP_DEBUG=false

# ── JWT（生产必须替换，长度至少 32 字符） ──
# 生成命令: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_WITH_GENERATED_RANDOM_SECRET

# ── 限流（可选） ──
# 普通 API 每 IP 每分钟请求上限；登录接口单独更严格（防爆破）
# RATE_LIMIT_PER_MINUTE=30
# LOGIN_RATE_LIMIT_PER_MINUTE=10
JWT_EXPIRATION_HOURS=2

# ── 调度器 ──
SCHEDULER_ENABLED=true
SCHEDULER_HOUR=15
SCHEDULER_MINUTE=30
SCAN_MAX_WORKERS=20

# ── 缓存 ──
CACHE_DIR=./data
CACHE_EXPIRE_HOURS=6

# ── CORS ──
# 生产必须换成受控的明确来源；禁止 *。多个来源使用逗号分隔。
CORS_ORIGINS=https://CHANGE_ME.example.com

# ── 日志 ──
LOG_LEVEL=INFO

# ── Gunicorn ──
# 进程内调度器启用时必须为 1。
GUNICORN_WORKERS=1

# ── 默认管理员 ──
DEFAULT_ADMIN_USER=CHANGE_ME_ADMIN_USER
DEFAULT_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ── 前端开发代理（生产必须关闭） ──
FRONTEND_DEV_PROXY=false

# ── Nginx ──
NGINX_PORT=80
