# ── 生产部署环境模板（腾讯云）──
# 复制为 .env 后逐项填写；.env 已被 .gitignore / .dockerignore 排除，绝不入库。
# 部署步骤见 docs/DEPLOY.md。密钥生成：
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# ── 必填：安全凭证 ──
# 至少 32 字符强随机串；泄露后所有 JWT 可被伪造，务必保密
JWT_SECRET=CHANGE_ME_WITH_GENERATED_RANDOM_SECRET

# 管理员账号（首启动自动创建；用户名不得为 admin，密码 >= 12 位且非示例值）
DEFAULT_ADMIN_USER=CHANGE_ME_ADMIN_USER
DEFAULT_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# 受信来源（显式列出，禁止通配符）。单容器同源部署填服务器对外访问地址即可。
# 例：CORS_ORIGINS=http://43.140.xxx.xxx 或 https://your-domain.com
CORS_ORIGINS=https://CHANGE_ME.example.com

# ── 可选：运行参数 ──
# 对外端口（宿主机映射到容器 5000）。有云负载均衡/TLS 时可改为 8080 等内部端口
APP_PORT=80

# 进程内调度器：必须保持单实例（GUNICORN_WORKERS=1）；确认只跑一个容器
SCHEDULER_ENABLED=true
GUNICORN_WORKERS=1
SCAN_MAX_WORKERS=20
LOG_LEVEL=INFO

# 前置了 TLS 终止（云 LB / Caddy / Nginx + 证书）时置 true，下发 HSTS
ENABLE_HSTS=false
